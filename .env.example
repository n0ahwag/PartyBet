# Firebase Web-Config (Konsole → Projekteinstellungen → Deine Apps).
# Ohne .env nutzt die App die Werte des Projekts partybe-d44b7 aus src/firebase.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = lokale Firebase-Emulatoren (npm run emulators) statt Cloud verwenden
VITE_USE_EMULATOR=false
